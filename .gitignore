# Repo-wide ignores. api/ and web/ each keep their own .gitignore for
# tool-specific output.

.DS_Store
Thumbs.db

# Secrets and local env
.env
.env.*
!.env.example
!.env.template

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/

# Editors
.idea/
.claude/settings.local.json

# Phone-size planet maps (tools/planets/far_maps.py makes them). Not committed until the system
# view becomes a route that uses them, to keep 21 MB of images out of git history until then.
web/static/system/*/mid/
