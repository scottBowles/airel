{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR\"/bin/cloud-session-start.sh",
						"timeout": 900
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR\"/bin/block-pr-merge.sh"
					}
				]
			},
			{
				"matcher": ".*[Mm]erge.*",
				"hooks": [
					{
						"type": "command",
						"command": "echo \"Blocked: in this repo agents don't merge pull requests or enable auto-merge. Leave the PR open; the user merges it.\" >&2; exit 2"
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(.venv/bin/python manage.py test:*)",
			"Bash(api/.venv/bin/python api/manage.py test:*)",
			"Bash(.venv/bin/python manage.py check:*)",
			"Bash(.venv/bin/python manage.py makemigrations --check:*)",
			"Bash(.venv/bin/black --check:*)",
			"Bash(vp check:*)",
			"Bash(vp test:*)",
			"Bash(vp lint:*)",
			"Bash(vp build:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr checks:*)",
			"Bash(gh run view:*)",
			"Bash(gh run list:*)",
			"mcp__svelte__get-documentation",
			"mcp__svelte__list-sections",
			"mcp__svelte__svelte-autofixer"
		],
		"deny": [
			"Read(./api/.env)",
			"Read(./web/.env)",
			"Read(**/.env.local)",
			"Read(**/.env.production)",
			"Edit(./api/.env)",
			"Edit(./web/.env)"
		]
	}
}
